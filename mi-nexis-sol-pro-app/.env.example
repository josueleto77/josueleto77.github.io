# ─────────────────────────────────────────────────────────────────────────
# Mi Nexis Sol Pro — environment variables
# Copy this file to .env.local (dev) or set these in your host's dashboard
# (production). Never commit a real .env file.
# ─────────────────────────────────────────────────────────────────────────

# Google Maps Platform — BROWSER key (exposed to the client on purpose).
# Restrict it in Google Cloud Console to: HTTP referrers = your domain(s),
# and APIs = Maps JavaScript API, Places API.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Google Solar API — SERVER key. Never prefix with NEXT_PUBLIC_. Restrict it
# in Google Cloud Console to: IP addresses (or "None" + rely on it never
# reaching the browser) and APIs = Solar API only.
GOOGLE_SOLAR_API_KEY=

# HubSpot Private App access token (server-only). Requires scopes:
# crm.objects.contacts.read/write, crm.objects.deals.read/write,
# crm.schemas.contacts.read, crm.schemas.deals.read, crm.objects.owners.read
HUBSPOT_ACCESS_TOKEN=

# HubSpot Sales pipeline that Nexis Power's solar deals live in.
HUBSPOT_PIPELINE_ID=

# The pipeline stage ID that new "hot" solar leads should land in.
HUBSPOT_HOT_DEAL_STAGE_ID=

# Public URL this app is deployed at (used for report links, canonical tags,
# and building absolute callback URLs). No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Default wattage per solar panel used throughout the sizing engine.
# Change this (and redeploy) any time Nexis Power's standard panel changes —
# no code changes required.
DEFAULT_PANEL_WATTAGE=450

# Postgres connection string for Prisma (e.g. from Vercel Postgres, Neon,
# Supabase, or RDS). Must include ?sslmode=require on most managed providers.
DATABASE_URL=

# Optional: comma-separated list of allowed origins for the analyze API's
# basic rate limiter / bot check. Leave blank to allow NEXT_PUBLIC_APP_URL only.
ALLOWED_ORIGINS=
